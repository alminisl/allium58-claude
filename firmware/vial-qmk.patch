 // raw_hid_send() is called at the end, with the same buffer, which was
 // possibly modified with returned values.
+// One-way display updates from a host bridge (allium58 claude keymap): no
+// reply. Echoing every one back fills the raw HID IN queue whenever the host
+// closes the device between updates, and on RP2040 that stalls the whole USB
+// stack, keyboard reports included, until the board is replugged.
+__attribute__((weak)) bool raw_hid_receive_noreply_kb(uint8_t *data, uint8_t length) {
+    return false;
+}
